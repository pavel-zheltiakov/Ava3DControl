<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      The package is in this repository, so the demo builds offline and against exactly the build the site
      documents. nuget.org is still listed because the demo also needs Avalonia and its friends.
    -->
    <add key="ava3d-local" value="packages" />
  </packageSources>
</configuration>
